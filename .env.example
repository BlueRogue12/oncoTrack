# OncoTrack Pipeline Configuration
# Copy this file to .env and update with your local paths

# ============================================
# REQUIRED: Fiji Installation
# ============================================
# Path to Fiji executable
# Linux/WSL: /home/phillip/Fiji/fiji-linux-x64
# Mac: /Applications/Fiji.app/Contents/MacOS/ImageJ-macosx
# Windows: C:/path/to/fiji-win64.exe
FIJI_PATH=/home/phillip/Fiji/fiji-linux-x64

# ============================================
# Frame Capture & Processing
# ============================================

# Where frameCapture.py saves screenshots (PRODUCER output)
# This is where the Qt GUI saves captured frames
# For now, use captures/ folder inside project (gitignored)
# In production, this could be a shared network drive
CAPTURE_OUTPUT_DIR=captures

# Which frames directory to process (CONSUMER input)
# For development: use committed sample data (vid1_frames_1-3)
# For testing: use your own captures (captures/)
# Can be relative (to project root) or absolute path
# Examples:
#   FRAMES_PATH=vid1_frames_1-3          # Sample data (committed)
#   FRAMES_PATH=captures                  # Your local captures (gitignored)
#   FRAMES_PATH=data/batches/my_batch    # Custom batch
#   FRAMES_PATH=/mnt/shared/microscope   # Network drive
FRAMES_PATH=vid1_frames_1-3

# ============================================
# Optional: Advanced Configuration
# ============================================

# Override database path (default: data/tracking.db)
# DB_PATH=data/tracking.db

# Override pipeline output directory (default: output/)
# OUTPUT_DIR=output

# Logging level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
